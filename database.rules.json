{
  "rules": {
    "menu": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "upiList": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      }
    },
    "eta": {
      "model": {
        ".read": true,
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())"
      },
      "modelPrevious": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      },
      "recalMeta": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      },
      "live": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      }
    },
    "ops": {
      // Written by the robot at the end of every scheduled run that FINISHED, and
    // read by .github/workflows/cron-heartbeat.yml and the Worker-health panel.
    // cronFailure says which job is failing; this says which job has stopped
    // running at all, which nothing could see before — a cron that never fires
    // writes no failure, pushes nothing, and looks exactly like a quiet week.
    "cronHeartbeat": {
      ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && auth.token.email === 'robot@cafeila.app'"
    },
    "cronFailure": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.token.email === 'robot@cafeila.app'"
      },
      "pushHealth": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.token.email === 'robot@cafeila.app'"
      },
      "clientErrors": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$sig": {
          ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())",
          ".validate": "newData.hasChildren(['page','message'])",
          "page":     { ".validate": "newData.isString() && newData.val().length <= 40" },
          "kind":     { ".validate": "newData.isString() && newData.val().length <= 20" },
          "message":  { ".validate": "newData.isString() && newData.val().length <= 300" },
          "source":   { ".validate": "newData.isString() && newData.val().length <= 200" },
          "build":    { ".validate": "newData.isString() && newData.val().length <= 40" },
          "count":    { ".validate": "newData.isNumber()" },
          "firstAt":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999" },
          "lastAt":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999" },
          "$other":   { ".validate": false }
        }
      }
    },
    "upiReview": {
      ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "upiRouting": {
      "config": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "totals": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$month": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
        }
      }
    },
    // GST INVOICES. The arithmetic and the document are gst.js; the writes are gstIssue in
    // pos.html and admin.html, which put the number, the invoice, the bill's index and the
    // customer's copy in ONE update — so these rules see all four together and can hold
    // each to the others.
    "gst": {
      // Everything here is the till's and the owner's: the cashier issues, the owner
      // cancels and reports. The bar, the kitchen and the stock screen have no use for
      // the café's turnover or its customers' GSTINs, so as with the ledger they are
      // not given it.
      //
      // The business as it is printed on an invoice, which accounts' UPI payments are
      // invoiced automatically, and where the month's invoices are mailed. The till reads
      // it to decide whether to issue; only the owner changes it; the Worker reads it for
      // the accountant's address.
      "settings": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || (root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      // The last serial used in each financial year. Rule 46 wants them consecutive, so
      // the only write there is is the next number: up by exactly one, never back, never
      // removed. Two tills asking at once both send N+1 and the second is refused here,
      // which is what tells it to read the counter again and take N+2.
      "counter": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$fy": {
          ".write": "auth != null && newData.exists() && (root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && newData.parent().parent().child('invoices').child($fy).child('' + newData.val()).exists()"
        }
      },
      "invoices": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || (root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        "$fy": {
          ".indexOn": ["at"],
          "$seq": {
            // Created once, by staff, as the number the counter moves to in the same
            // write, dated by the server rather than by a tablet's clock. After that only
            // the owner may change it, and only to cancel it: its number, date, money
            // and link stay what they were, because an invoice that has gone to a
            // customer cannot be quietly rewritten.
            ".write": "auth != null && newData.exists() && ((!data.exists() && (root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin')) || (data.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
            ".validate": "newData.hasChildren(['no','seq','fy','at','total','taxable','cgst','sgst','token','status']) && newData.child('seq').isNumber() && $seq === '' + newData.child('seq').val() && newData.child('fy').val() === $fy && newData.child('total').isNumber() && newData.child('taxable').isNumber() && (data.exists() ? (newData.child('no').val() === data.child('no').val() && newData.child('seq').val() === data.child('seq').val() && newData.child('at').val() === data.child('at').val() && newData.child('total').val() === data.child('total').val() && newData.child('taxable').val() === data.child('taxable').val() && newData.child('cgst').val() === data.child('cgst').val() && newData.child('sgst').val() === data.child('sgst').val() && newData.child('token').val() === data.child('token').val()) : (newData.child('seq').val() === newData.parent().parent().parent().child('counter').child($fy).val() && newData.child('status').val() === 'issued' && newData.child('at').val() === now && newData.parent().parent().parent().child('public').child(newData.child('token').val()).child('no').val() === newData.child('no').val()))",
            "status": { ".validate": "newData.val() === 'issued' || newData.val() === 'cancelled'" },
            "token": { ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 40" }
          }
        }
      },
      // Which invoice a bill has, so a bill is invoiced once however many tills or
      // screens ask. Created with its invoice; removed only by the owner, when that
      // invoice is cancelled and the bill is to be invoiced again.
      "byBill": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$bill": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && (root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin')) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.isString() && newData.val().length <= 20"
        }
      },
      // The customer's own invoice, by a 20-character random token that is the whole of
      // their link. Readable by whoever holds the token and by nobody else — there is no
      // read on the node above, so it cannot be listed. It carries what the customer
      // asked to be printed (their name, GSTIN, address) and nothing they did not: see
      // publicCopy in gst.js, which drops their phone and the café's account.
      "public": {
        "$token": {
          ".read": true,
          ".write": "auth != null && newData.exists() && ((!data.exists() && (root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin')) || (data.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
          ".validate": "$token.length >= 16 && $token.length <= 40 && newData.hasChildren(['no','total','status']) && (data.exists() ? newData.child('no').val() === data.child('no').val() && newData.child('total').val() === data.child('total').val() : newData.child('at').val() === now)"
        }
      },
      // What the Worker did about each month's email to the accountant. Its record, so
      // only it writes here; the owner's screen reads it to say whether a month went.
      "mailLog": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.token.email === 'robot@cafeila.app'"
      }
    },
    "orders": {
      "pendingWeb": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        "$orderId": {
          ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').exists())",
          ".validate": "newData.hasChildren(['items','total','orderType']) && newData.child('total').isNumber() && (data.exists() || (!newData.child('createdAt').exists() || newData.child('createdAt').val() === now))",
          "items": {
            ".validate": "newData.hasChildren()",
            "$item": {
              ".validate": "newData.hasChildren(['qty','price'])",
              "qty": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
              },
              "price": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "base": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "mods": {},
              "$other": {
                ".validate": false
              }
            }
          },
          "orderType": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "tableOrAddress": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "paymentMethod": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "upiId": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "trackId": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "gated": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "billedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "manualPaid": {
            ".validate": "newData.hasChildren(['by','at']) && auth != null && root.child('users').child(auth.uid).child('role').exists()",
            "by": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
            },
            "via": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "$other": {
              ".validate": false
            }
          },
          "payment": {
            ".validate": "newData.hasChildren(['ref','amount']) && auth != null && root.child('users').child(auth.uid).child('role').exists()",
            "ref": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
            },
            "payId": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "bankTag": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "refundsDue": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "active": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "ready": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "completed": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "track": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$trackId": {
          ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').exists())",
          ".validate": "data.exists() || (newData.hasChildren(['status','items','table']) && (!newData.child('createdAt').exists() || newData.child('createdAt').val() === now))",
          "status": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "table": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "items": {
            ".validate": "newData.hasChildren()",
            "$item": {
              ".validate": "newData.hasChildren(['qty','price'])",
              "qty": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
              },
              "price": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "base": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "mods": {},
              "$other": {
                ".validate": false
              }
            }
          },
          "gated": {
            ".validate": "newData.isBoolean()"
          },
          "paymentVerified": {
            ".validate": "newData.isBoolean()"
          },
          "refundDue": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "acceptedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "readyAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "rejectedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "stations": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "stationsDone": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "predLow": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "predHigh": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "predPoint": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "predOvenIdleMin": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "predLoadChef": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "quotedLow": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 240"
          },
          "quotedHigh": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 240"
          },
          "quotedLive": {
            ".validate": "newData.isBoolean()"
          },
          "predLoadBarista": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "predModelVersion": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          },
          "predWorkChef": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "predWorkBarista": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "predCapped": {
            ".validate": "newData.isBoolean()"
          },
          "quotedCapped": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          ".read": true
        }
      },
      "daily": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$day": {
          ".validate": "newData.hasChildren(['rev','orders'])",
          "rev":    { ".validate": "newData.isNumber()" },
          "orders": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "pay":    { "$method": { ".validate": "newData.isNumber()" } },
          "type":   { "$kind":   { ".validate": "newData.isNumber() && newData.val() >= 0" } },
          "hour":   { "$h":      { ".validate": "newData.isNumber() && newData.val() >= 0" } },
          "item":   { "$name": {
            ".validate": "newData.hasChildren(['q','r'])",
            "q": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "r": { ".validate": "newData.isNumber()" },
            "o": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false } } },
          "$other": { ".validate": false }
        }
      },
      "history": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".indexOn": [
          "ts"
        ]
      },
      "tableIndex": {
        "$tableLabel": {
          ".read": true,
          "$trackId": {
            ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || !data.exists() || root.child('users').child(auth.uid).child('role').exists())",
            ".validate": "newData.isNumber()"
          }
        },
        ".read": "auth != null && auth.token.email === 'robot@cafeila.app'"
      }
    },
    "customers": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      "$phone": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      }
    },
    "pos": {
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      "ledgerEntries": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'cashier')",
        ".indexOn": [
          "ts"
        ],
        "$entry": {
          ".validate": "!newData.child('type').exists() || auth.token.email === 'robot@cafeila.app' || (newData.child('type').val() !== 'expense' && newData.child('type').val() !== 'withdrawal' && newData.child('type').val() !== 'tip_payout')"
        },
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())"
      },
      "eodSummary": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$day": {
          ".validate": "newData.hasChildren(['cash','upi','bills','closedAt'])",
          "cash":     { ".validate": "newData.isNumber()" },
          "upi":      { ".validate": "newData.isNumber()" },
          "bills":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "closedBy": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "closedAt": { ".validate": "newData.isNumber()" },
          "$other":   { ".validate": false }
        }
      },
      "eodSummaryBackfill": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['at'])",
        "at":   { ".validate": "newData.isNumber()" },
        "days": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      },
      "eodArchive": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$archive": {
          "lateVerified": {
            ".write": "auth != null && auth.token.email === 'robot@cafeila.app'",
            "$payId": {
              ".validate": "newData.hasChildren(['ref','at'])",
              "ref":     { ".validate": "newData.isString() && newData.val().length <= 60" },
              "at":      { ".validate": "newData.isNumber()" },
              "amount":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "bankTag": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "$other":  { ".validate": false }
            }
          }
        }
      },
      "bills": {
        ".indexOn": [
          "id"
        ],
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "activeTables": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "cashDrawer": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())"
      },
      "lastSplitHeads": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "tips": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "upiTotal": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "unverified": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'cashier')",
        "$payId": {
          ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())"
        }
      }
    },
    "inventory": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      "stock": {
        ".write": "auth != null && auth.token.email === 'robot@cafeila.app'"
      },
      "logs": {
        ".write": "auth != null && auth.token.email === 'robot@cafeila.app'"
      },
      "config": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "recipes": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())"
      }
    },
    "security": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
    },
    "staff": {
      ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || auth.uid === $uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "reconciliation": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "monitor": {
      ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "pushSubscriptions": {
      ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "payments": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      "incoming": {
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".indexOn": [
          "at"
        ],
        "$ref": {
          ".validate": "newData.hasChildren(['amount','ref','at']) && newData.child('amount').isNumber()"
        }
      },
      "claims": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      }
    },
    ".read": false,
    ".write": false
  }
}
