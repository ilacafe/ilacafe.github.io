{
  "rules": {
    "menu": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "upiList": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      }
    },
    "eta": {
      "model": {
        ".read": true,
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())"
      },
      "modelPrevious": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      },
      "recalMeta": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      },
      "live": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      }
    },
    "ops": {
      "cronFailure": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.token.email === 'robot@cafeila.app'"
      },
      "pushHealth": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.token.email === 'robot@cafeila.app'"
      }
    },
    "upiReview": {
      ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "upiRouting": {
      "config": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "totals": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$month": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
        }
      }
    },
    "orders": {
      "pendingWeb": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        "$orderId": {
          ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').exists())",
          ".validate": "newData.hasChildren(['items','total','orderType']) && newData.child('total').isNumber() && (data.exists() || (!newData.child('createdAt').exists() || newData.child('createdAt').val() === now))",
          "items": {
            ".validate": "newData.hasChildren()",
            "$item": {
              ".validate": "newData.hasChildren(['qty','price'])",
              "qty": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
              },
              "price": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "base": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "mods": {},
              "$other": {
                ".validate": false
              }
            }
          },
          "orderType": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "tableOrAddress": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "paymentMethod": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "upiId": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "trackId": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "gated": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "payLinkSentAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "payment": {
            ".validate": "newData.hasChildren(['ref','amount'])",
            "ref": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
            },
            "payId": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "bankTag": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "refundsDue": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "active": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "ready": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "completed": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').exists())",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "track": {
        ".read": true,
        ".indexOn": [
          "table"
        ],
        "$trackId": {
          ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').exists())",
          ".validate": "data.exists() || (newData.hasChildren(['status','items','table']) && (!newData.child('createdAt').exists() || newData.child('createdAt').val() === now))",
          "status": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "table": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "items": {
            ".validate": "newData.hasChildren()",
            "$item": {
              ".validate": "newData.hasChildren(['qty','price'])",
              "qty": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
              },
              "price": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "base": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "mods": {},
              "$other": {
                ".validate": false
              }
            }
          },
          "gated": {
            ".validate": "newData.isBoolean()"
          },
          "paymentVerified": {
            ".validate": "newData.isBoolean()"
          },
          "refundDue": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "acceptedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "readyAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "rejectedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999999999999"
          },
          "stations": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "stationsDone": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "predLow": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "predHigh": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "predPoint": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "predOvenIdleMin": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "predLoadChef": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "predLoadBarista": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "predModelVersion": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "history": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".indexOn": [
          "ts"
        ]
      }
    },
    "customers": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
    },
    "pos": {
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      "ledgerEntries": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'cashier')",
        ".indexOn": [
          "ts"
        ]
      },
      "eodArchive": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      },
      "bills": {
        ".indexOn": [
          "id"
        ],
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "activeTables": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "cashDrawer": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "lastSplitHeads": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "tips": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "upiTotal": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      },
      "unverified": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'cashier')"
      }
    },
    "inventory": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
    },
    "security": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
    },
    "staff": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || auth.uid === $uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "reconciliation": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "monitor": {
      ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "pushSubscriptions": {
      ".read": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "payments": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      "incoming": {
        ".write": "auth != null && (auth.token.email === 'robot@cafeila.app' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".indexOn": [
          "at"
        ],
        "$ref": {
          ".validate": "newData.hasChildren(['amount','ref','at']) && newData.child('amount').isNumber()"
        }
      },
      "claims": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
      }
    },
    ".read": false,
    ".write": false
  }
}
